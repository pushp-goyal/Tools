{
  "manifest_version": 3,
  "name": "Design Notes for AI",
  "version": "2.1.0",
  "description": "Click any element on a page, say what should change, add a screenshot, then copy every note as one prompt for your AI coding agent.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "downloads",
    "downloads.ui"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Design notes",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "options_page": "options.html",
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Show or hide design notes"
    },
    "toggle-selecting": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Start or pause selecting elements"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "defaults.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "css": [
        "page.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.css"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
